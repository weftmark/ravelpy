{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Uvicorn: examples/server.py",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "examples.server:app",
        "--reload",
        "--host", "0.0.0.0"
      ],
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "python": "${workspaceFolder}/.venv/Scripts/python.exe"
    }
  ]
}
